{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "npm run ci:vercel",
  "devCommand": "npm run dev",
  "installCommand": "npm ci --no-audit --no-fund",
  "framework": "nextjs",
  "crons": [
    {
      "path": "/api/internal/maintenance",
      "schedule": "0 0 * * *"
    }
  ]
}
